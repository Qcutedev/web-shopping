# Copy this file to `.env` (git-ignored) for local development.
# LOCAL DEVELOPMENT VALUES ONLY. Nothing here is a real credential. The values
# match the throwaway defaults in docker-compose.yml, whose containers listen
# on 127.0.0.1 only. Never put staging or production values in this file.

# The application validates the variables below when the server starts
# (src/server/env.ts; rules in docs/DEPLOYMENT.md, "Environment variables"). A
# missing or invalid one stops the start and is reported by name, never by value.
# NODE_ENV is not set here: the framework sets it (`next dev`, `next build`, `next start`).

# Public origin of the application: an absolute http or https URL. Required.
APP_URL="http://localhost:3000"

# Number of reverse proxies in front of the application that the operator
# controls, 0 to 5 (SECURITY.md SR-01). 0 = none, which is right for local
# development. Optional here; must be set explicitly when NODE_ENV=production.
TRUSTED_PROXY_HOPS=0

# Name of a single-value header that the hosting platform's proxy always
# overwrites with the client address (SR-01). Leave empty unless the platform
# documents one. Cannot be combined with TRUSTED_PROXY_HOPS greater than 0.
TRUSTED_CLIENT_IP_HEADER=

# Minutes an order may await payment before it is failed, 1 to 1440. Default 15 (D-028).
PAYMENT_TIMEOUT_MINUTES=15

# Sign-ups allowed per client address per hour, 1 to 1000. Default 5; leave it unset. Only the
# e2e server sets it (playwright.config.ts, 1000). The server refuses to start when it is set and
# NODE_ENV=production, even to 5. See docs/DEPLOYMENT.md, "Environment variables".
# SIGN_UP_RATE_LIMIT=

# Demo only (D-052). A production server refuses the mock payment (SEC-056) unless this is exactly
# 1. No money moves; orders stay labelled simulated. Leave unset for any real deployment.
# ALLOW_MOCK_PAYMENT=

# Absolute directory where the local disk adapter keeps uploaded files (T-041). It is
# not a secret. An absolute path cannot be written once for every machine, so replace the
# example below with a directory of yours; /uploads/ in the repository root is git-ignored.
# Optional while NODE_ENV is development or test, but until it is set the upload and file
# endpoints answer 500. Required when NODE_ENV=production unless BLOB_READ_WRITE_TOKEN is set
# (below); a relative path is refused in every environment. See docs/DEPLOYMENT.md, "Uploaded files".
# Windows example: UPLOAD_DIR="C:\dev\web shoping\uploads"
# Linux/macOS example: UPLOAD_DIR="/home/you/web-shoping/uploads"
UPLOAD_DIR=

# Vercel Blob read-write token: the other upload storage, for a host without a persistent disk
# (D-051). A SECRET: never write a real token in this file or commit it; set it only in the
# host's environment settings. When it is set, uploads are stored as private Vercel Blob objects
# and UPLOAD_DIR must be empty (both set is refused in every environment). When NODE_ENV=production,
# exactly one of UPLOAD_DIR and BLOB_READ_WRITE_TOKEN must be set. Leave it unset for local work.
# See docs/DEPLOYMENT.md, "Deploying to Vercel".
# BLOB_READ_WRITE_TOKEN=

# true when the scheduled work (payment timeout sweep, upload orphan cleanup, session purge) is
# triggered from outside through POST /api/v1/internal/maintenance (D-051), for a serverless host
# where the in-process timers do not run. Exactly true or false. Default false: the timers run.
# See docs/DEPLOYMENT.md, "Scheduled work".
MAINTENANCE_VIA_HTTP=false

# Bearer secret of POST /api/v1/internal/maintenance. A SECRET: never write a real value in this
# file or commit it; set it only in the host's environment settings and in the GitHub Actions
# secret of the same name. 32 to 256 characters of the base64 or base64url alphabet only
# (A-Z a-z 0-9 + / = - _; SEC-097), and not equal to AUTH_SECRET. Required when NODE_ENV=production and MAINTENANCE_VIA_HTTP=true. Unset means the
# endpoint refuses every request. Generate one with: openssl rand -base64 48
# CRON_SECRET=

# debug, info, warn, or error. Default info. Lines written through logger.security()
# (SR-01 start-up warning, SR-02 saturation warning, SR-04 events) are never filtered
# by it; see docs/DEPLOYMENT.md, "What LOG_LEVEL reaches".
# Do not set NEXT_PHASE here or anywhere at run time (docs/DEPLOYMENT.md, SEC-029).
LOG_LEVEL=info

# Development database connection string, used by the app and by Prisma (service `db-dev`).
# Required. The password below is refused when NODE_ENV=production (SEC-009), in any
# spelling the database driver would decode to it, and also in PGPASSWORD (SEC-025).
DATABASE_URL="postgresql://marketplace:local_dev_only_not_a_secret@127.0.0.1:5432/marketplace_dev?schema=public"

# Secret that signs the session cookie. Required in every environment, at least 32 characters,
# no default. The value below is a throwaway for local development: it is refused when
# NODE_ENV=production because it contains "not_a_secret". Generate a real one per environment,
# for example: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it ends every session. When NODE_ENV=production it is also refused when it has fewer
# than 8 distinct characters, is a shorter part repeated, or is a published value (SEC-044).
# Do not set BETTER_AUTH_SECRET, BETTER_AUTH_SECRETS, BETTER_AUTH_URL,
# BETTER_AUTH_TRUSTED_ORIGINS, BETTER_AUTH_TELEMETRY, BETTER_AUTH_TELEMETRY_ENDPOINT, or
# BETTER_AUTH_TELEMETRY_DEBUG anywhere: the server refuses to start when one is set
# (SEC-045, SEC-046).
AUTH_SECRET="local_dev_only_not_a_secret_change_me_0123456789"

# The next two entries are for tooling, not for normal runs, and stay commented out.
#
# One-shot input of `pnpm admin:bootstrap` (docs/DEPLOYMENT.md, "First administrator"). Set them
# in the shell for that one command only, then remove them. Never write a real password into
# .env. EMAIL and PASSWORD are required (password 8 to 128 characters); NAME is optional
# (default Admin). See the README for the PowerShell steps.
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=
# ADMIN_BOOTSTRAP_NAME=
#
# Build output directory read by next.config.ts. Default .next. Set by playwright.config.ts
# (.next-e2e) and scripts/build-probe.ps1 so they do not share .next with `pnpm dev`. Leave it
# unset for normal work and for production.
# NEXT_DIST_DIR=.next

# Test database connection string, used by integration tests (service `db-test`; emptied on every container start).
# Local and CI only: the server refuses to start when it is set and NODE_ENV=production (SEC-009).
DATABASE_URL_TEST="postgresql://marketplace:local_test_only_not_a_secret@127.0.0.1:5433/marketplace_test?schema=public"

# Optional overrides read by docker-compose.yml. Uncomment only to change a
# default (for example when a host port is taken), and update the URL above to match.
# POSTGRES_DEV_USER=marketplace
# POSTGRES_DEV_PASSWORD=local_dev_only_not_a_secret
# POSTGRES_DEV_DB=marketplace_dev
# POSTGRES_DEV_PORT=5432
# POSTGRES_TEST_USER=marketplace
# POSTGRES_TEST_PASSWORD=local_test_only_not_a_secret
# POSTGRES_TEST_DB=marketplace_test
# POSTGRES_TEST_PORT=5433
