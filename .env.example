# Copy this file to `.env` (git-ignored) for local development.
# LOCAL DEVELOPMENT VALUES ONLY. Nothing here is a real credential. The values
# match the throwaway defaults in docker-compose.yml, whose containers listen
# on 127.0.0.1 only. Never put staging or production values in this file.

# Development database connection string, used by the app and by Prisma (service `db-dev`).
DATABASE_URL="postgresql://marketplace:local_dev_only_not_a_secret@127.0.0.1:5432/marketplace_dev?schema=public"

# Test database connection string, used by integration tests (service `db-test`; emptied on every container start).
DATABASE_URL_TEST="postgresql://marketplace:local_test_only_not_a_secret@127.0.0.1:5433/marketplace_test?schema=public"

# Optional overrides read by docker-compose.yml. Uncomment only to change a
# default (for example when a host port is taken), and update the URL above to match.
# POSTGRES_DEV_USER=marketplace
# POSTGRES_DEV_PASSWORD=local_dev_only_not_a_secret
# POSTGRES_DEV_DB=marketplace_dev
# POSTGRES_DEV_PORT=5432
# POSTGRES_TEST_USER=marketplace
# POSTGRES_TEST_PASSWORD=local_test_only_not_a_secret
# POSTGRES_TEST_DB=marketplace_test
# POSTGRES_TEST_PORT=5433
