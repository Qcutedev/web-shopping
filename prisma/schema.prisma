// Schema v1 (T-013). The specification is docs/DATA_MODEL.md; from now on this file is
// authoritative and that document must match it.
//
// Not expressible here, and therefore hand-written in the migration (DATA_MODEL.md section 13):
// every CHECK constraint, the three partial unique indexes, the sequence behind
// `Order.orderNumber`, the single `MarketplaceSettings` row, and (since the migration
// `maintenance_status`) the single `MaintenanceStatus` row and its id check. Since the migration
// `store_name_key` (section 21.7) also the function "store_name_key" and the generated column
// `Store.nameKey`; the schema declares that column only so that the client can read it.
//
// Conventions:
// - Money is integer satang in `Int` columns whose names end in `Satang`. No Float, no Decimal.
// - Every timestamp is `timestamptz(3)` and holds UTC.
// - Application ids are `cuid(2)` strings. Ids of the four auth tables are generated by the auth
//   library. Every id is an opaque string.
// - Every foreign key states its `onDelete`. The default of this project is `Restrict`.
// - Every unique constraint is named with `map:` because services catch violations by name.

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------------------------
// Enums (DATA_MODEL.md section 3)
// ---------------------------------------------------------------------------------------------

enum Role {
  CUSTOMER
  SELLER
  ADMIN
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StoreStatus {
  APPROVED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  TAKEN_DOWN
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentProvider {
  MOCK
}

enum FulfilmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

// ---------------------------------------------------------------------------------------------
// Auth tables (DATA_MODEL.md section 6.1)
//
// Fields, types, nullability, defaults, the unique and index attributes, and the cascade on
// `userId` are those of the core tables of Better Auth 1.7.7 (`getAuthTables` in
// @better-auth/core 1.7.7, as its CLI `auth` 1.7.7 writes them for Prisma and PostgreSQL).
// Three deliberate differences from what that CLI writes:
// - no `@@map("user")` and so on: the tables keep the model names ("User", "Session", ...),
//   which is what every statement in DATA_MODEL.md uses. The library addresses Prisma models,
//   not tables, so it does not see the difference;
// - `@db.Timestamptz(3)` on every DateTime (project convention: timestamps are timestamptz);
// - the project's own columns and relations on `User`, and the index on `Session(expiresAt)`.
// T-015 installs the library and corrects any difference with a new migration.
// ---------------------------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  // Added by this application. Never set from a request body (DATA_MODEL.md section 6.1).
  role     Role    @default(CUSTOMER)
  isActive Boolean @default(true)
  phone    String?

  sessions Session[]
  accounts Account[]

  addresses            Address[]
  store                Store?
  sellerApplications   SellerApplication[]   @relation("SellerApplicationApplicant")
  reviewedApplications SellerApplication[]   @relation("SellerApplicationReviewer")
  cart                 Cart?
  orders               Order[]
  reviews              Review[]              @relation("ReviewAuthor")
  hiddenReviews        Review[]              @relation("ReviewHiddenBy")
  auditLogs            AuditLog[]
  settingsUpdates      MarketplaceSettings[]
  rateLimitWindows     UserRateLimitWindow[]

  @@unique([email], map: "User_email_key")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token], map: "Session_token_key")
  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

// ---------------------------------------------------------------------------------------------
// Application tables (DATA_MODEL.md sections 6.2 to 6.18)
//
// `updatedAt` has a database default besides `@updatedAt` so that a raw INSERT need not supply
// it. A raw UPDATE must set `"updatedAt" = now()` itself: `@updatedAt` only acts on writes made
// through the Prisma client API.
// ---------------------------------------------------------------------------------------------

model Address {
  id            String   @id @default(cuid(2))
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  recipientName String
  phone         String
  line1         String
  subdistrict   String
  district      String
  province      String
  postalCode    String
  isDefault     Boolean
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  // Raw SQL: partial unique index "Address_userId_default_key" (one default per user).
  @@index([userId])
}

model Store {
  id           String      @id @default(cuid(2))
  ownerId      String
  owner        User        @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name         String
  // Generated by the database from `name` (STORED generated column, raw SQL function
  // "store_name_key": NFKC, full case folding, default-ignorables removed, white space collapsed
  // and trimmed; DATA_MODEL.md section 21.7). Never written by the application: Prisma omits it
  // from inserts because of the default, and an update that sets it fails. Unique, so two stores
  // cannot have names that differ only in case, width, or spacing (SEC-058, D-041).
  nameKey      String      @default(dbgenerated("store_name_key(name)"))
  slug         String
  description  String?
  logoUploadId String?
  logoUpload   Upload?     @relation("StoreLogo", fields: [logoUploadId], references: [id], onDelete: Restrict)
  contactPhone String
  // No default: the approval transaction writes APPROVED explicitly (section 4.1).
  status       StoreStatus
  statusReason String?
  isSample     Boolean     @default(false)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @default(now()) @updatedAt @db.Timestamptz(3)

  products     Product[]
  uploads      Upload[]      @relation("UploadOwner")
  sellerOrders SellerOrder[]

  @@unique([ownerId], map: "Store_ownerId_key")
  @@unique([slug], map: "Store_slug_key")
  @@unique([nameKey], map: "Store_nameKey_key")
  @@unique([logoUploadId], map: "Store_logoUploadId_key")
  @@index([status])
}

model SellerApplication {
  id           String            @id @default(cuid(2))
  userId       String
  user         User              @relation("SellerApplicationApplicant", fields: [userId], references: [id], onDelete: Restrict)
  storeName    String
  description  String
  contactPhone String
  status       ApplicationStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?             @relation("SellerApplicationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewNote   String?
  reviewedAt   DateTime?         @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @default(now()) @updatedAt @db.Timestamptz(3)

  // Raw SQL: partial unique index "SellerApplication_userId_pending_key".
  @@index([status, createdAt])
}

model Category {
  id        String   @id @default(cuid(2))
  name      String
  slug      String
  sortOrder Int
  isActive  Boolean  @default(true)
  isSample  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  products Product[]

  @@unique([slug], map: "Category_slug_key")
}

model Product {
  id                    String           @id @default(cuid(2))
  storeId               String
  store                 Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  categoryId            String
  category              Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title                 String
  slug                  String
  description           String
  sku                   String
  priceSatang           Int
  // Raw SQL: "Product_stock_check" allows 0 to 1,000,000,000 by design. That is the bound of the
  // column, not the seller's entry limit of 1,000,000 (BR-34), which is enforced by the guard of
  // the seller's stock statement and not by the column, so that restored stock is never refused
  // (docs/DATA_MODEL.md section 11).
  stock                 Int
  status                ProductStatus    @default(DRAFT)
  moderationStatus      ModerationStatus @default(PENDING)
  moderationNote        String?
  // A new product is PENDING, and entering PENDING sets this time (section 4.2), so the insert
  // default is the database clock. Later writes set it explicitly with now().
  moderationRequestedAt DateTime         @default(now()) @db.Timestamptz(3)
  contentRevision       Int              @default(1)
  isSample              Boolean          @default(false)
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime         @default(now()) @updatedAt @db.Timestamptz(3)

  images     ProductImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]

  // Raw SQL: partial unique index "Product_storeId_sku_live_key" on (storeId, sku)
  // WHERE status <> 'ARCHIVED'. There is deliberately no @@unique([storeId, sku]) here.
  @@unique([slug], map: "Product_slug_key")
  @@index([status, moderationStatus, categoryId, createdAt])
  @@index([storeId, status])
  @@index([moderationStatus, moderationRequestedAt])
}

model Upload {
  id          String   @id @default(cuid(2))
  storageKey  String
  storeId     String
  store       Store    @relation("UploadOwner", fields: [storeId], references: [id], onDelete: Restrict)
  contentType String
  sizeBytes   Int
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  productImage ProductImage?
  logoOfStore  Store?        @relation("StoreLogo")
  orderItems   OrderItem[]

  @@unique([storageKey], map: "Upload_storageKey_key")
  @@index([storeId])
}

model ProductImage {
  id        String   @id @default(cuid(2))
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  uploadId  String
  upload    Upload   @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  sortOrder Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([uploadId], map: "ProductImage_uploadId_key")
  @@unique([productId, sortOrder], map: "ProductImage_productId_sortOrder_key")
}

model Cart {
  id        String   @id @default(cuid(2))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  items CartItem[]

  @@unique([userId], map: "Cart_userId_key")
}

model CartItem {
  id        String   @id @default(cuid(2))
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([cartId, productId], map: "CartItem_cartId_productId_key")
}

model Order {
  id                  String        @id @default(cuid(2))
  // Filled by the database from the sequence "order_number_seq" (section 10). The expression is
  // written the way PostgreSQL prints it back, so that `migrate dev` sees no difference.
  orderNumber         String        @default(dbgenerated("(('OD'::text || to_char((now() AT TIME ZONE 'Asia/Bangkok'::text), 'YYMMDD'::text)) || to_char(nextval('order_number_seq'::regclass), 'FM9999999990000000'::text))"))
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  // Plain text. The API layer defines the one normalised form (T-032); the database compares
  // the stored value exactly.
  idempotencyKey      String
  paymentStatus       PaymentStatus @default(PENDING)
  paidAt              DateTime?     @db.Timestamptz(3)
  itemsSubtotalSatang Int
  shippingTotalSatang Int
  grandTotalSatang    Int
  shipRecipientName   String
  shipPhone           String
  shipLine1           String
  shipSubdistrict     String
  shipDistrict        String
  shipProvince        String
  shipPostalCode      String
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @default(now()) @updatedAt @db.Timestamptz(3)

  sellerOrders SellerOrder[]
  payment      Payment?

  @@unique([orderNumber], map: "Order_orderNumber_key")
  @@unique([userId, idempotencyKey], map: "Order_userId_idempotencyKey_key")
  @@index([userId, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([paidAt])
}

model SellerOrder {
  id                     String           @id @default(cuid(2))
  orderId                String
  order                  Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  storeId                String
  store                  Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  storeName              String
  fulfilmentStatus       FulfilmentStatus @default(PENDING)
  itemsSubtotalSatang    Int
  shippingFeeSatang      Int
  shippingFeeIsSimulated Boolean          @default(true)
  commissionRateBps      Int
  createdAt              DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime         @default(now()) @updatedAt @db.Timestamptz(3)

  items    OrderItem[]
  shipment Shipment?

  @@unique([orderId, storeId], map: "SellerOrder_orderId_storeId_key")
  @@index([storeId, fulfilmentStatus, createdAt])
}

model OrderItem {
  id                       String      @id @default(cuid(2))
  sellerOrderId            String
  sellerOrder              SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  productId                String
  product                  Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  productTitle             String
  productSku               String
  productImageUploadId     String?
  productImageUpload       Upload?     @relation(fields: [productImageUploadId], references: [id], onDelete: Restrict)
  unitPriceSatang          Int
  quantity                 Int
  lineTotalSatang          Int
  stockRestoredAt          DateTime?   @db.Timestamptz(3)
  cartQuantityBeforeReturn Int?
  cartQuantityAfterReturn  Int?
  createdAt                DateTime    @default(now()) @db.Timestamptz(3)

  review Review?

  @@index([sellerOrderId])
  @@index([productId])
  // SEC-067: the "is this upload referenced by an order" lookup (file serving, upload cap,
  // orphan cleanup) and the Restrict check of every Upload delete.
  @@index([productImageUploadId])
}

model Payment {
  id                String          @id @default(cuid(2))
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider          PaymentProvider
  providerReference String?
  amountSatang      Int
  failureReason     String?
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([orderId], map: "Payment_orderId_key")
}

model Shipment {
  id             String      @id @default(cuid(2))
  sellerOrderId  String
  sellerOrder    SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  carrierName    String?
  trackingNumber String?
  isSimulated    Boolean     @default(true)
  shippedAt      DateTime    @db.Timestamptz(3)
  deliveredAt    DateTime?   @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([sellerOrderId], map: "Shipment_sellerOrderId_key")
}

model Review {
  id          String    @id @default(cuid(2))
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  userId      String
  user        User      @relation("ReviewAuthor", fields: [userId], references: [id], onDelete: Restrict)
  rating      Int
  comment     String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  // Admin hide (SECURITY.md SEC-092; DATA_MODEL.md section 6.15). All three null: the review is
  // public. `hiddenAt` and `hiddenByUserId` set: hidden from the public list and the rating
  // summary; `hiddenReason` is optional. Raw SQL: "Review_hidden_pair_check",
  // "Review_hiddenReason_check" (1 to 500 characters), and the partial index
  // "Review_productId_createdAt_visible_idx" (WHERE "hiddenAt" IS NULL).
  hiddenAt       DateTime? @db.Timestamptz(3)
  hiddenByUserId String?
  hiddenBy       User?     @relation("ReviewHiddenBy", fields: [hiddenByUserId], references: [id], onDelete: Restrict)
  hiddenReason   String?

  @@unique([orderItemId], map: "Review_orderItemId_key")
  @@index([productId, createdAt])
}

// Single row, id 1 (CHECK in raw SQL). The row is inserted by the first migration.
model MarketplaceSettings {
  id                    Int      @id
  flatShippingFeeSatang Int
  commissionRateBps     Int
  updatedById           String?
  updatedBy             User?    @relation(fields: [updatedById], references: [id], onDelete: Restrict)
  updatedAt             DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

// Liveness of the scheduled maintenance run (SECURITY.md SEC-100 remediation (b); DATA_MODEL.md
// section 6.19). Single row, id 1 (CHECK "MaintenanceStatus_id_check" in raw SQL), inserted by the
// migration with every time NULL, which reads as "never ran" and not as a failure. No personal
// data and no foreign key. `lastRunAt` and `lastRunOk` describe the latest run; `lastSuccessAt` is
// the latest run in which all three jobs (payment timeout sweep, upload cleanup, session purge)
// succeeded. No `createdAt`, as for `MarketplaceSettings`: the row's creation time means nothing.
model MaintenanceStatus {
  id            Int       @id
  lastSuccessAt DateTime? @db.Timestamptz(3)
  lastRunAt     DateTime? @db.Timestamptz(3)
  lastRunOk     Boolean?
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
}

model AuditLog {
  id         String   @id @default(cuid(2))
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  targetType String
  targetId   String
  metadata   Json
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([targetType, targetId])
}

// Per-user rate-limit windows kept in the database (SECURITY.md SEC-052 option (b); DATA_MODEL.md
// section 6.18). One row per user and rule: the current window's count and the time it ends. Its
// size is bounded by the number of accounts times the rules, so no shared capacity can be filled.
// Raw SQL: "UserRateLimitWindow_count_check" (count >= 1) and "UserRateLimitWindow_rule_check"
// (rule is 'seller-application' or 'review-create'); a new rule needs a migration that replaces
// the second check. Written by one atomic upsert on "UserRateLimitWindow_userId_rule_key"
// (section 6.18), never read-then-write. A surrogate `id` and not a composite primary key: every
// application table has an `id` (section 1), which the test snapshot orders rows by.
model UserRateLimitWindow {
  id        String   @id @default(cuid(2))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule      String
  count     Int
  resetAt   DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([userId, rule], map: "UserRateLimitWindow_userId_rule_key")
  @@index([resetAt])
}
